# Copy these into .env.local (gitignored) — NOT .env, which is committed.

# SeatGeek Platform API — create an app at https://seatgeek.com/account/develop
# Only the Client ID goes here. Never put the Client Secret in frontend code.
VITE_SEATGEEK_CLIENT_ID=

# Optional: only show concerts in one city (leave blank for everywhere)
VITE_SEATGEEK_CITY=
